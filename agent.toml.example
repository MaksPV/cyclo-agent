# Пример конфига cyclo-agent. Путь по умолчанию: /etc/cyclo-agent/agent.toml
# schedule — единственный ключ пути: каталог выводится из него сам
# (абсолютный — как есть, относительный — от текущей директории).
schedule = "/etc/cyclo-agent/schedule.cyclo"
db = "/var/lib/cyclo-agent/agent.db"
# web = "127.0.0.1:8080"  # без ключа — демон без веба
poll_secs = 10
lookahead_secs = 60
concurrency = 4
retention_days = 90
retention_max_rows = 1000000
