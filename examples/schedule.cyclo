schedule "Agent" {
  point JOB {
    actions = [fire];
  }

  cycle RUN(job) duration = 1m {
    0m: JOB.fire() {"cmd": job.cmd, "args": job.args, "tags": job.tags, "timeout_s": job.timeout_s};
  }

  cycle HOURLY(task) duration = 1h {
    0m: RUN(task);
  }

  root_cycle start_time = "2026-01-01T00:00:00", duration = 24h {
    0h: fill RUN({"cmd": "/bin/echo", "args": ["metrics"], "tags": ["metrics"], "timeout_s": 10});
    0h: fill HOURLY({"cmd": "/bin/echo", "args": ["ping"], "tags": ["ping"], "timeout_s": 10});
    3h: RUN({"cmd": "/bin/echo", "args": ["backup"], "tags": ["backup"], "timeout_s": 10});
  }
}
